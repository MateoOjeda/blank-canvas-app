rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/user_roles/$(userId)).data.role;
    }

    function isStudentOfTrainer(trainerId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/trainer_students/$(trainerId)_$(request.auth.uid))
      );
    }

    function isTrainerOfStudent(studentId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/trainer_students/$(request.auth.uid)_$(studentId))
      );
    }

    // Profiles: Read restricted to owners, linked trainers, and students viewing their trainer's profile.
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        getRole(request.auth.uid) == "trainer" ||
        getRole(userId) == "trainer"
      );
      allow write: if isOwner(userId);
    }

    // User Roles: Read by anyone authenticated.
    match /user_roles/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (getRole(request.auth.uid) == "trainer" && request.resource.data.role == "student") ||
        (request.auth.uid == docId && request.resource.data.user_id == docId && request.resource.data.role == "student")
      );
      allow update, delete: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer"
      );
    }

    // Trainer-Student Links: Read for trainer and linked student.
    match /trainer_students/{linkId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id || 
        request.auth.uid == resource.data.student_id
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.trainer_id ||
        request.auth.uid == request.resource.data.student_id
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id && 
        getRole(request.auth.uid) == "trainer"
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id || 
        request.auth.uid == resource.data.student_id
      );
    }

    // Exercises: Read restricted to owning trainer or assigned student.
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Routines: Only trainers can write/modify routines.
    match /routines/{routineId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id || 
        (resource.data.target_type == 'ALUMNO' && request.auth.uid == resource.data.target_id)
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Training Groups: Read restricted to owning trainer or group member.
    match /training_groups/{groupId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        exists(/databases/$(database)/documents/training_group_members/$(resource.data.id)_$(request.auth.uid))
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Group Members: Read for assigned student or linked trainer.
    match /training_group_members/{memberId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer"
      );
    }

    // Group Exercises: Read for owning trainer or group member.
    match /group_exercises/{exId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        exists(/databases/$(database)/documents/training_group_members/$(resource.data.group_id)_$(request.auth.uid))
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Routine Day Config: Read allowed for trainer/student. Write restricted to trainers.
    match /routine_day_config/{configId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id || 
        request.auth.uid == resource.data.student_id
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Global Plans: Read restricted to owning trainer or linked student.
    match /global_plans/{planId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        isStudentOfTrainer(resource.data.trainer_id)
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Plan Levels: Read restricted to trainer or assigned student.
    match /plan_levels/{levelId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && request.auth.uid == resource.data.trainer_id)
        )
      );
    }

    // Custom Surveys: Read restricted to authoring trainer or assigned student.
    match /custom_surveys/{surveyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        exists(/databases/$(database)/documents/survey_assignments/$(resource.data.id)_$(request.auth.uid))
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && (!("trainer_id" in resource.data) || resource.data.trainer_id == null || request.auth.uid == resource.data.trainer_id))
        )
      );
    }
    
    // Survey Questions: Read restricted to authoring trainer or assigned student.
    match /survey_questions/{questionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        exists(/databases/$(database)/documents/survey_assignments/$(resource.data.survey_id)_$(request.auth.uid))
      );
      allow write: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          (request.resource != null && request.auth.uid == request.resource.data.trainer_id) ||
          (resource != null && (!("trainer_id" in resource.data) || resource.data.trainer_id == null || request.auth.uid == resource.data.trainer_id))
        )
      );
    }
    
    // Personal Diagnostic: Restricted to student owner or linked trainer.
    match /seguimiento_personal/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && request.auth.uid == request.resource.data.student_id) ||
        (resource != null && request.auth.uid == resource.data.student_id)
      );
    }
    
    // Survey Assignments: Read restricted to trainer or assigned student.
    match /survey_assignments/{assignId} {
      allow read: if isAuthenticated() && (
        !("trainer_id" in resource.data) ||
        resource.data.trainer_id == null ||
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
      allow create: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" &&
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update: if isAuthenticated() && (
        (getRole(request.auth.uid) == "trainer" && (!("trainer_id" in resource.data) || resource.data.trainer_id == null || request.auth.uid == resource.data.trainer_id)) ||
        (request.auth.uid == resource.data.student_id && request.resource.data.status == "completada")
      );
      allow delete: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          !("trainer_id" in resource.data) ||
          resource.data.trainer_id == null ||
          request.auth.uid == resource.data.trainer_id
        )
      );
    }
    
    // Survey Answers: Read restricted to trainer or assigned student.
    match /survey_answers/{answerId} {
      allow read: if isAuthenticated() && (
        !("trainer_id" in resource.data) ||
        resource.data.trainer_id == null ||
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update, delete: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" && (
          !("trainer_id" in resource.data) ||
          resource.data.trainer_id == null ||
          request.auth.uid == resource.data.trainer_id
        )
      );
    }

    // Trainer Changes (Notifications)
    match /trainer_changes/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
      allow create: if isAuthenticated() && (
        getRole(request.auth.uid) == "trainer" &&
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update: if false; // Changes are immutable
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        request.auth.uid == resource.data.student_id
      );
    }

    // System & User Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }


    // Exercise Logs: Read/Write for trainer and student.
    match /exercise_logs/{logId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id ||
        (resource != null && (request.auth.uid == resource.data.student_id || request.auth.uid == resource.data.trainer_id))
      );
    }

    // Student Meals: Read/Write for trainer and student.
    match /student_meals/{mealId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id ||
        (resource != null && (request.auth.uid == resource.data.student_id || request.auth.uid == resource.data.trainer_id))
      );
    }

    // Photo Sessions: Student-owned. Read restricted to student, creator trainer, or linked trainer.
    match /photo_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.student_id;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.student_id;
    }

    // Tracking Assessments: Read/Write for student, creator trainer, or linked trainer.
    match /tracking_assessments/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
    }

    // Tracking Injuries: Read/Write for student, creator trainer, or linked trainer.
    match /tracking_injuries/{injuryId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
    }

    // Tracking Goals: Read/Write for student, creator trainer, or linked trainer.
    match /tracking_goals/{goalId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
    }

    // Tracking Notes (Trainer-authored): Trainer can CRUD. Student can read public notes.
    match /tracking_notes/{noteId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.trainer_id ||
        (request.auth.uid == resource.data.student_id && resource.data.visibility == "publica")
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.trainer_id;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.trainer_id;
    }

    // Student Notes: Student-owned progress notes. Linked trainer can read.
    match /student_notes/{noteId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.student_id;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.student_id;
    }

    // Weight History: Student writes their weight. Linked trainer can read.
    match /weight_history/{entryId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.student_id;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.student_id;
    }

    // Tracking Recovery: Read/Write for student, creator trainer, or linked trainer.
    match /tracking_recovery/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id ||
        isTrainerOfStudent(resource.data.student_id)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.student_id ||
        request.auth.uid == request.resource.data.trainer_id
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.student_id ||
        request.auth.uid == resource.data.trainer_id
      );
    }

    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
