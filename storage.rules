rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profiles — avatar photos: public read, owner-only write
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Photo sessions — progress photos: authenticated read/write
    // The actual ownership check is in Firestore rules; Storage
    // restricts access to authenticated users only.
    match /photo_sessions/{sessionId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
